---
import { getOrderedCollection, getSection } from "../../lib/content";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import TextLink from "../ui/TextLink.astro";
import { CV_URL, EMAIL_ROLE_URL } from "../../lib/seo";

const facts = await getOrderedCollection("facts", Astro.currentLocale);
const copy = await getSection(Astro.currentLocale, "hero");
---

<section class="pt-[clamp(40px,6vw,88px)] pb-[clamp(56px,7vw,96px)]">
    <Container class="grid grid-cols-1 items-center gap-[clamp(40px,6vw,88px)] md:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)]">
        <div>
            <h1 class="max-w-[15ch] text-[clamp(40px,5.3vw,74px)] leading-[.98] font-extrabold tracking-[-.04em]">
                <span class="block motion-safe:opacity-0 print:transform-none! print:opacity-100!" data-rise="0">
                    {copy.titleLead}
                </span>
                <span
                    class="block text-pine motion-safe:opacity-0 print:transform-none! print:opacity-100!"
                    data-rise="180"
                >
                    {copy.titleAccent}
                </span>
            </h1>
            <p
                class="mt-7 max-w-[52ch] text-[clamp(18px,1.6vw,21px)] leading-[1.6] text-ink-soft motion-safe:opacity-0 print:transform-none! print:opacity-100!"
                data-rise="400"
            >
                {copy.intro}
            </p>
            <div
                class="mt-8.5 flex flex-wrap items-center gap-x-6.5 gap-y-3.5 motion-safe:opacity-0 print:hidden"
                data-rise="550"
            >
                <Button href={EMAIL_ROLE_URL}>{copy.email}</Button>
                <TextLink href={CV_URL} download>
                    {copy.cv}
                </TextLink>
            </div>
        </div>
        <dl
            class="border-t-2 border-ink motion-safe:opacity-0 print:transform-none! print:opacity-100!"
            aria-label={copy.factsLabel}
            data-rise="700"
        >
            {facts.map(({ data }) => (
                <div class="grid grid-cols-[100px_1fr] gap-3.5 border-b border-line py-3.25 sm:grid-cols-[118px_1fr]">
                    <dt class="pt-0.5 font-display text-[14px] font-medium text-muted">{data.label}</dt>
                    <dd class="text-[16px] leading-[1.45]">{data.value}</dd>
                </div>
            ))}
        </dl>
    </Container>
</section>

<script>
    import { riseIn } from "../../scripts/animations";

    riseIn();
</script>
