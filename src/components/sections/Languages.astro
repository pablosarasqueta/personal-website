---
import { getOrderedCollection, getSection } from "../../lib/content";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const languages = await getOrderedCollection("languages", Astro.currentLocale);
const { title } = await getSection(Astro.currentLocale, "languages");
---

<Section id="languages" labelledby="lang-title" tight>
    <SectionHeading id="lang-title">{title}</SectionHeading>
    <ul class="mt-10">
        {languages.map(({ data }) => (
            <li class="flex flex-col items-baseline gap-1 border-b border-line py-3.5 first:border-t-2 first:border-ink sm:flex-row sm:justify-between sm:gap-5">
                <span class="font-display text-[clamp(34px,5.2vw,64px)] leading-none font-bold tracking-[-.04em]">
                    {data.name}
                </span>
                <span class="text-left text-[16px] text-muted sm:text-right">{data.level}</span>
            </li>
        ))}
    </ul>
</Section>
