---
import { getOrderedCollection, getSection } from "../../lib/content";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Intro from "../ui/Intro.astro";
import TextLink from "../ui/TextLink.astro";

const stops = await getOrderedCollection("stops", Astro.currentLocale);
const copy = await getSection(Astro.currentLocale, "explorandogs");
const { guide } = copy;
---

<Section id="explorandogs" labelledby="explore-title" class="bg-paper-2 print:bg-white print:text-black">
    <div class="grid grid-cols-1 items-start gap-[clamp(32px,6vw,80px)] md:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)]">
        <div>
            <SectionHeading id="explore-title">{copy.title}</SectionHeading>
            <p class="mt-3.5 font-display text-[15px] text-muted">{copy.meta}</p>
        </div>
        <div class="space-y-4 text-ink-soft">
            {copy.intro.map(text => (
                <Intro>{text}</Intro>
            ))}
        </div>
    </div>

    <div data-route-track class="relative mt-[clamp(56px,7vw,88px)] [--end:20px] [--p:0]">
        <span
            aria-hidden="true"
            class="absolute top-5 bottom-(--end) left-[19px] z-1 w-[3px] origin-top scale-y-(--p) rounded-[2px] bg-linear-to-b from-pine to-signal print:hidden"
        ></span>
        <span
            aria-hidden="true"
            class="absolute top-[calc(20px+(100%-20px-var(--end))*var(--p))] left-[20.5px] z-1 size-2.5 -translate-1/2 rounded-full bg-signal shadow-[0_0_0_4px_color-mix(in_oklab,var(--color-signal)_30%,transparent),0_0_18px_4px_var(--color-signal)] print:hidden"
        ></span>
        <ol
            data-route
            aria-label={copy.routeLabel}
            class="relative before:absolute before:top-5 before:bottom-(--end) before:left-[19px] before:w-[3px] before:bg-[repeating-linear-gradient(to_bottom,var(--color-line)_0_6px,transparent_6px_12px)]"
        >
            {stops.map(({ data }, i) => (
                <li
                    data-stop
                    class="group relative z-2 grid grid-cols-1 gap-x-12 gap-y-2 pb-11.5 pl-15.5 not-data-reached:*:not-data-mark:opacity-45 last:pb-0 *:not-data-mark:transition-opacity *:not-data-mark:duration-500 md:grid-cols-[minmax(0,300px)_minmax(0,1fr)] md:pl-18 print:*:opacity-100!"
                >
                    <span
                        data-mark
                        aria-hidden="true"
                        class="absolute top-0 left-0 grid size-10.25 scale-85 place-items-center rounded-full border-3 border-line bg-paper-2 font-display text-[15px] font-bold text-muted transition-[background-color,border-color,color,scale,box-shadow] duration-500 ease-[cubic-bezier(.34,1.56,.64,1)] before:absolute before:inset-0 before:-z-1 before:rounded-full before:bg-signal before:opacity-0 group-data-reached:scale-100 group-data-reached:border-pine group-data-reached:bg-signal group-data-reached:text-ink group-data-reached:shadow-[0_0_0_6px_color-mix(in_oklab,var(--color-signal)_22%,transparent)] dark:group-data-reached:text-paper motion-safe:group-data-current:before:animate-ping motion-safe:group-data-current:before:opacity-60 motion-reduce:transition-none print:scale-100 print:bg-white! print:shadow-none"
                    >
                        {i + 1}
                    </span>
                    <div>
                        <p class="mt-px font-display text-[14px] font-semibold text-pine">{data.tag}</p>
                        <h3 class="mt-1 text-[clamp(22px,2.3vw,28px)] tracking-[-.025em]">{data.title}</h3>
                    </div>
                    <p class="max-w-[58ch] pt-1 text-[17px] text-ink-soft">{data.body}</p>
                </li>
            ))}
        </ol>
    </div>

    <div class="mt-[clamp(64px,8vw,104px)] grid grid-cols-1 items-center gap-[clamp(32px,6vw,80px)] border-t-2 border-ink pt-[clamp(40px,5vw,64px)] md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
        <div>
            <h3 class="text-[clamp(28px,3.3vw,40px)] tracking-[-.03em]">{guide.title}</h3>
            <p class="mt-4 max-w-[56ch] text-ink-soft">{guide.text}</p>
            <TextLink
                class="mt-5.5 inline-block"
                href="/explorandogs-rome-travel-guide.pdf"
                target="_blank"
                rel="noopener"
            >
                {guide.link}
            </TextLink>
        </div>
        <div
            aria-hidden="true"
            class="flex aspect-3/4 w-[220px] rotate-[2.5deg] flex-col justify-between justify-self-center rounded-[4px] border border-line bg-white px-6 dark:bg-paper py-6.5 shadow-[10px_12px_0_var(--color-pine)] md:w-[min(100%,280px)]"
        >
            <div class="flex justify-between font-display text-[13px] text-muted">
                <span>{guide.cardBrand}</span>
                <span>{guide.cardPages}</span>
            </div>
            <div class="font-serif text-[40px] leading-[1.02]">
                {guide.cardTitle}
                <i class="block text-[62px] text-pine">{guide.cardCity}</i>
            </div>
            <div class="border-t border-line pt-2.5 font-display text-[13px] font-semibold">{guide.cardFooter}</div>
        </div>
    </div>

    <p class="mt-[clamp(48px,6vw,72px)] max-w-text text-ink-soft">
        <strong class="font-semibold text-ink">{copy.closingLead}</strong>
        {copy.closing}
    </p>
</Section>

<script>
    import { onScrollFrame } from "../../scripts/scroll";

    const route = document.querySelector<HTMLElement>("[data-route]");
    const track = document.querySelector<HTMLElement>("[data-route-track]");
    const stops = [...document.querySelectorAll<HTMLElement>("[data-stop]")];
    const center = (stop: HTMLElement) => {
        const mark = stop.querySelector("[data-mark]")!.getBoundingClientRect();
        return mark.top + mark.height / 2;
    };

    if (route && track && stops.length) {
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        onScrollFrame(() => {
            const line = window.innerHeight * 0.6;
            const start = center(stops[0]);
            const end = center(stops.at(-1)!);
            track.style.setProperty("--end", `${route.getBoundingClientRect().bottom - end}px`);
            track.style.setProperty(
                "--p",
                reduced ? "1" : String(Math.max(0, Math.min(1, (line - start) / (end - start)))),
            );
            const reached = reduced ? stops : stops.filter(stop => center(stop) < line);
            stops.forEach(stop => {
                stop.toggleAttribute("data-reached", reached.includes(stop));
                stop.toggleAttribute("data-current", stop === reached.at(-1));
            });
        });
    }
</script>
