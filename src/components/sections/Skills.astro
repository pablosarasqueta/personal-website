---
import { getOrderedCollection, getSection } from "../../lib/content";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const skills = await getOrderedCollection("skills", Astro.currentLocale);
const { title } = await getSection(Astro.currentLocale, "skills");
---

<Section id="skills" labelledby="skills-title" tight>
    <SectionHeading id="skills-title">{title}</SectionHeading>
    <div class="mt-10 grid grid-cols-1 gap-7 md:grid-cols-3 md:gap-10">
        {skills.map(({ data }) => (
            <div class="border-t-2 border-ink pt-4.5">
                <h3 class="text-[19px] tracking-[-.01em]">{data.title}</h3>
                <ul class="mt-3">
                    {data.items.map(item => (
                        <li class="py-1.25 text-[17px] text-ink-soft">{item}</li>
                    ))}
                </ul>
            </div>
        ))}
    </div>
</Section>
