---
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Intro from "../ui/Intro.astro";
import { getSection } from "../../lib/content";

const copy = await getSection(Astro.currentLocale, "hitDeporte");
---

<Section
    id="hitdeporte"
    labelledby="hit-title"
    containerClass="grid grid-cols-1 items-start gap-[clamp(32px,6vw,80px)] md:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)]"
>
    <div>
        <SectionHeading id="hit-title">{copy.title}</SectionHeading>
        <p
            aria-hidden="true"
            class="font-display text-[clamp(120px,18vw,240px)] leading-[.8] font-extrabold tracking-[-.06em] text-pine md:mt-4.5"
        >
            {copy.age}
            <span class="mt-4 block text-[16px] leading-[1.4] font-medium tracking-normal text-muted">
                {copy.ageCaption}
            </span>
        </p>
    </div>
    <div class="space-y-4 text-ink-soft">
        {copy.intro.map(text => (
            <Intro>{text}</Intro>
        ))}
    </div>
</Section>
