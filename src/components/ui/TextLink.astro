---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
    href: string;
    tone?: "light" | "dark";
}

const { tone = "light", class: className, ...attrs } = Astro.props;
---

<a
    {...attrs}
    class:list={[
        "font-display text-[16px] font-semibold underline decoration-signal decoration-2 underline-offset-5",
        tone === "light" ? "hover:decoration-ink" : "text-white hover:decoration-white",
        className,
    ]}
>
    <slot />
</a>
