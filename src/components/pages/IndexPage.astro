---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../sections/Header.astro";
import Hero from "../sections/Hero.astro";
import Explorandogs from "../sections/Explorandogs.astro";
import HitDeporte from "../sections/HitDeporte.astro";
import Why from "../sections/Why.astro";
import Experience from "../sections/Experience.astro";
import Education from "../sections/Education.astro";
import Languages from "../sections/Languages.astro";
import Skills from "../sections/Skills.astro";
import Contact from "../sections/Contact.astro";
import { getOrderedCollection, getPage } from "../../lib/content";
import { localeAlternates, toLocale } from "../../lib/i18n";
import { profilePageSchema } from "../../lib/seo";

const locale = toLocale(Astro.currentLocale);
const { title, description, ogDescription, jobTitle } = await getPage(locale, "index");
const skills = await getOrderedCollection("skills", locale);

const jsonLd = profilePageSchema({
    url: new URL(Astro.url.pathname, Astro.site).href,
    lang: locale,
    title,
    description,
    jobTitle: jobTitle ?? title,
    knowsAbout: skills.flatMap(({ data }) => data.items),
});
---

<BaseLayout
    title={title}
    description={description}
    ogDescription={ogDescription}
    lang={locale}
    alternates={localeAlternates()}
    jsonLd={jsonLd}
>
    <Header />
    <main>
        <Hero />
        <Explorandogs />
        <HitDeporte />
        <Why />
        <Experience />
        <Education />
        <Languages />
        <Skills />
    </main>
    <Contact />
</BaseLayout>

<script>
    import { redirectToPreferredLocale } from "../../scripts/lang";

    redirectToPreferredLocale(document.documentElement.lang);
</script>
