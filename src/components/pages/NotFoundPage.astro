---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { getPage } from "../../lib/content";
import { DEFAULT_LOCALE, LOCALES, localeHref } from "../../lib/i18n";

const copies = await Promise.all(
    LOCALES.map(async locale => {
        const page = await getPage(locale, "404");
        if (!page.notFound) throw new Error(`Missing notFound copy: add it to src/content/pages/${locale}/404.json`);
        return { ...page, ...page.notFound, locale };
    }),
);
const { title, description, noindex } = copies.find(copy => copy.locale === DEFAULT_LOCALE)!;
---

<BaseLayout title={title} description={description} noindex={noindex ?? true}>
    <main>
        <section class="flex min-h-svh items-center py-[clamp(56px,7vw,96px)]">
            <Container>
                <p
                    class="border-l-4 border-signal pl-3 font-display text-[15px] font-semibold text-muted motion-safe:opacity-0"
                    data-rise="0"
                >
                    404
                </p>
                <h1 class="mt-6 text-[clamp(32px,4.4vw,60px)] leading-[1.05] font-extrabold tracking-[-.04em]">
                    {copies.map(({ locale, titleLead }, i) => (
                        <span
                            lang={locale}
                            class:list={["block motion-safe:opacity-0", i > 0 && "text-pine"]}
                            data-rise={120 + i * 150}
                        >
                            {titleLead}
                        </span>
                    ))}
                </h1>
                <div class="mt-8.5 flex flex-wrap gap-3.5 motion-safe:opacity-0" data-rise="650">
                    {copies.map(({ locale, home }) => (
                        <Button href={localeHref(locale)}>{home}</Button>
                    ))}
                </div>
            </Container>
        </section>
    </main>
</BaseLayout>

<script>
    import { riseIn } from "../../scripts/animations";

    riseIn();
</script>
